          "cancelled"
        ]
      },
      "notes": "pending = confirmation sent and waiting for 1/2; manual = a person changed the Woo status, the workflow stops"
    },
    "outbound_send": {
      "metaKey": "rhymat_whatsapp_<send>_state",
      "states": [
        "",
        "deferred",
        "reserved",
        "sent",
        "failed"
      ],
      "transitions": {
        "": [
          "reserved",
          "deferred",
          "failed"
        ],
        "deferred": [
          "reserved",
          "deferred"
        ],
        "reserved": [
          "sent",
          "",
          "failed"
        ],
        "sent": [],
        "failed": []
      },
      "notes": "reserved = written before the provider call; sent = provider answered; \"\" = a clean refusal cleared the reservation; deferred = held by the quiet hours; failed = number not on WhatsApp (stage messages)"
    },
    "hd_send": {
      "metaKey": "rhymat_hd_api_state",
      "states": [
        "",
        "failed",
        "sending",
        "sent",
        "unknown"
      ],
      "transitions": {
        "": [
          "sending"
        ],
        "failed": [
          "sending"
        ],
        "sending": [
          "sent",
          "failed",
          "unknown"
        ],
        "sent": [],
        "unknown": []
      },
      "notes": "sending = written right before the parcel creation (the claim rhymat_hd_api_claim is taken earlier, before the warehouse/trust checks); unknown = no answer, the parcel may exist"
    }
  },
